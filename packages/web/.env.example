# Every value here is optional. With none set, the app reads Arc mainnet through its public RPC.

# Server-side RPCs for the API routes. Defaults: https://rpc.mainnet.arc.io, then https://rpc.drpc.mainnet.arc.io
ARC_RPC_URL=
ARC_RPC_FALLBACK_URL=

# The site's own public URL, used for absolute links in shared preview cards. On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=

# The public repository's URL. It turns the review documents named on /terms into links.
NEXT_PUBLIC_REPO_URL=

# A Reown (WalletConnect) project id. It takes effect only once the WalletConnect provider package is installed.
NEXT_PUBLIC_WC_PROJECT_ID=

# A Safe Transaction Service API key from https://developer.safe.global. Server-side only: never prefix it with
# NEXT_PUBLIC_. Without it, "Pay from a Safe" answers that Safe proposals are not configured yet.
SAFE_API_KEY=

# The loan guard's keeper and Telegram alerts. Server only: none of these may ever start with NEXT_PUBLIC_.
# The keeper wallet only pays gas for AdagGuard.protect; keep a few USDC in it and nothing else.
KEEPER_PRIVATE_KEY=
# The keeper wallet's address, checked against the key on every run.
KEEPER_ADDRESS=
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/keeper/run. vercel.json runs it once a day,
# the most Hobby allows; on Pro, change the schedule to "* * * * *" for every minute.
CRON_SECRET=
# The security token of the QuickNode webhook on AnswerUpdated from the two price aggregators (POST /api/hooks/quicknode).
QUICKNODE_WEBHOOK_SECRET=
# From @BotFather. The bot token and the secret_token given to setWebhook (letters, digits, _ and -, up to 256).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Upstash Redis REST credentials. The Vercel Marketplace names them KV_REST_API_URL and KV_REST_API_TOKEN; either works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tests and local builds only. Never set these for a real deployment.
#   SAFE_TX_SERVICE_URL      points the server at a local stand-in Safe Transaction Service (scripts/e2e.mjs)
#   NEXT_PUBLIC_ARC_RPC_URL  points the whole app, browser included, at a local fork (scripts/e2e.mjs)
#   NEXT_PUBLIC_ADAG_E2E     set to 1 to switch on the end-to-end test hook
#   NEXT_PUBLIC_ADAG_GUARD_E2E  AdagGuard's address on the fork (scripts/e2e-guard.mjs); read only when the hook is on
#   ADAG_E2E_TELEGRAM_API    a local mock of Telegram's API on 127.0.0.1; read only when the hook is on
#   ADAG_STORE_NAMESPACE     set to "test:" to keep every store key under that prefix
#   NEXT_DIST_DIR            a second build folder, so a check build never touches the dev server's .next
